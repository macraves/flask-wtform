# Copy to .env for local development. Never commit .env.

# Recommended. Without it a random key is used and sessions reset on restart.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Enables automatic book cover lookup by ISBN (RapidAPI Book Cover API).
# Without it, books are saved with no cover.
RAPIDAPI_KEY=
