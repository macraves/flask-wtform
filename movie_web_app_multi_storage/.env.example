# Copy to .env for local development. Never commit .env.
# Used by both moviewebapp_latest and "using session".

# Recommended. Without it a random key is used and sessions reset on restart.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required to add movies. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
