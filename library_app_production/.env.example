# Copy to .env for local development. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Defaults to the local SQLite file data/library.sqlite.
# postgres:// URLs are rewritten to postgresql:// automatically.
SQLALCHEMY_DATABASE_URI=

# Optional. Enables automatic book cover lookup by ISBN (RapidAPI Book Cover API).
# Without it, books are saved with no cover.
RAPIDAPI_KEY=
